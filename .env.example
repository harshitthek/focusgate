# Copy values into your shell environment or a local process launcher before running focusgate.

# Optional: Stage-2 semantic classification via TypeSafe System One (https://api.typesafe.ai)
TYPESAFE_API_KEY=

# Optional: Require Bearer/token authentication for LAN/Tailscale/VPS UI & API access
FOCUSGATE_AUTH_TOKEN=

# Optional: Require Bearer / X-Webhook-Secret / GitHub HMAC signature on /api/webhook/*
FOCUSGATE_WEBHOOK_SECRET=

# Optional: Slack Events API app mentions for the operator inbox
FOCUSGATE_SLACK_SIGNING_SECRET=
FOCUSGATE_SLACK_WORKSPACE_ID=
FOCUSGATE_SLACK_MENTION_USER_ID=

# Optional: GitHub Personal Access Token (notifications scope)
GITHUB_TOKEN=

# Optional: IMAP app password for read-only email polling
IMAP_APP_PASSWORD=

# Optional: ntfy access token (if using a protected topic or self-hosted ntfy server)
NTFY_TOKEN=

# Android sync (public URLs baked into configured APKs)
FOCUSGATE_NEON_AUTH_URL=
FOCUSGATE_SYNC_URL=
FOCUSGATE_ASSESSMENT_URL=
FOCUSGATE_DASHBOARD_URL=https://sandoxed.xyz

# Optional Android assessment running on the daemon: disabled, jev, local-model
FOCUSGATE_ASSESSMENT_PROVIDER=disabled
FOCUSGATE_ASSESSMENT_JEV_API_KEY=
# Optional endpoint for the dedicated key (defaults to https://api.typesafe.ai).
FOCUSGATE_ASSESSMENT_JEV_BASE_URL=
FOCUSGATE_LOCAL_MODEL_URL=
